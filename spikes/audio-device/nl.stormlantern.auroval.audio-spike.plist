<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>nl.stormlantern.auroval.audio-spike</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Application Support/Auroval/audio-spike/reader</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>nl.stormlantern.auroval.audio</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/auroval-audio-spike.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/auroval-audio-spike.log</string>
</dict>
</plist>
