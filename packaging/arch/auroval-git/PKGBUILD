# Maintainer: Dirk Louwers <dirk.louwers@stormlantern.nl>
#
# Auroval Linux client, built from the latest commit on main.
# From a checkout: cd packaging/arch/auroval-git && makepkg -si
#
# To build another branch or a local clone (e.g. to test a PR before it
# merges), override the source:
#   AUROVAL_BRANCH=my-branch makepkg -si
#   AUROVAL_REPO=file:///path/to/auroval AUROVAL_BRANCH=my-branch makepkg -si

pkgname=auroval-git
_name=auroval
pkgver=0
pkgrel=1
pkgdesc='Remote desktop client: control a Mac from Linux (Wayland) (git main)'
arch=('x86_64' 'aarch64')
url='https://github.com/stormlantern-dev/aetherdesk'
license=('Apache-2.0 OR MIT' 'OFL-1.1')
depends=('sdl3' 'ffmpeg' 'libgcc' 'glibc' 'hicolor-icon-theme')
makedepends=('cargo' 'clang' 'git' 'pkgconf')
# makepkg's LTO turns ring's C code into GCC bitcode that rust-lld can't link.
options=('!lto')
provides=("$_name")
conflicts=("$_name")
source=("$_name::git+${AUROVAL_REPO:-$url.git}#branch=${AUROVAL_BRANCH:-main}")
sha256sums=('SKIP')

pkgver() {
  cd "$_name"
  if git describe --tags --long >/dev/null 2>&1; then
    git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    # No release tag yet.
    printf '0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_name"
  # Ignore rust-toolchain.toml: it pins a version and adds the macOS target,
  # which only the host build needs.
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p auroval-linux-client --bin auroval
}

check() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release -p auroval-linux-client
}

package() {
  cd "$_name"
  local id=nl.stormlantern.Auroval
  install -Dm755 target/release/auroval -t "$pkgdir/usr/bin/"
  install -Dm644 "packaging/linux/$id.desktop" -t "$pkgdir/usr/share/applications/"
  install -Dm644 "packaging/linux/$id.metainfo.xml" -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 "packaging/linux/icons/$id.svg" -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  local size
  for size in 32 48 64 128 256; do
    install -Dm644 "packaging/linux/icons/$id-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$id.png"
  done
  install -Dm644 LICENSE-APACHE LICENSE-MIT assets/fonts/Inter-OFL.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
